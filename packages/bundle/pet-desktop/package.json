{
  "name": "@luv1211/dsh-pet-desktop",
  "description": "Customizable desktop pets for DeepSeek Harness: your sprite-based characters, agent activity, Web controls, and an optional Electron companion",
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luv061211/dsh-pet.git",
    "directory": "packages/bundle/pet-desktop"
  },
  "homepage": "https://github.com/Luv061211/dsh-pet#readme",
  "bugs": {
    "url": "https://github.com/Luv061211/dsh-pet/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "customizable-pets",
    "custom-pet-pack",
    "sprite-animation",
    "agent-status",
    "electron",
    "cordis"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@luv1211/dsh-client-ui-pet": "workspace:^",
    "@luv1211/dsh-command-pet": "workspace:^",
    "@luv1211/dsh-desktop-companion": "workspace:^",
    "@luv1211/dsh-pet": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6-rc.4",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  },
  "scripts": {
    "bundle": "tsdown"
  }
}
